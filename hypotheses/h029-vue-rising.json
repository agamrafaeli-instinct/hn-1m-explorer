{
  "schema": 1,
  "id": "h029",
  "title": "Vue is rising",
  "author": "engineers-deeper-agent",
  "audience": "engineers",
  "hypothesis": "Vue grows as a share of stories.",
  "expect": "If true, the share of stories mentioning Vue should be at least 1.3x higher in the latest 6 months than the first 6 (1.1x is weak, 0.95x or lower refutes it).",
  "check": {
    "source": "data/engineers_history.json",
    "path": "monthly",
    "label_field": "month",
    "stat": "mean_ratio_a_over_b",
    "unit": "x",
    "field": "vue_s",
    "per_label": "share of stories",
    "group_a": {
      "label": "Latest 6 months",
      "indices": [
        -6,
        -5,
        -4,
        -3,
        -2,
        -1
      ],
      "field": "vue_s",
      "per": "s_total"
    },
    "group_b": {
      "label": "First 6 months",
      "indices": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "field": "vue_s",
      "per": "s_total"
    },
    "display_pct": true
  },
  "verdicts": [
    {
      "when": {
        "op": ">=",
        "value": 1.3
      },
      "verdict": "supported",
      "confidence": "strong"
    },
    {
      "when": {
        "op": ">=",
        "value": 1.1
      },
      "verdict": "supported",
      "confidence": "weak"
    },
    {
      "when": {
        "op": "<=",
        "value": 0.95
      },
      "verdict": "refuted",
      "confidence": "strong"
    },
    {
      "else": true,
      "verdict": "inconclusive",
      "confidence": "inconclusive"
    }
  ],
  "caveats": [
    "Small monthly counts, noisy.",
    "Text matches in stories, word boundaries, case-insensitive. Complete months Jan 2023 to Jun 2026. Thresholds were fixed before this card was run, but the author had seen rough term ratios earlier."
  ]
}