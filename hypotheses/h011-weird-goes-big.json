{
  "schema": 1,
  "id": "h011",
  "title": "Weird goes big",
  "author": "agam",
  "audience": "curious readers",
  "hypothesis": "Strange, old and mysterious stories travel further than the average story.",
  "expect": "If true, stories with words like weird, mystery, ancient, abandoned or forgotten in the title should average at least 1.3x the points per story of all other stories (1.1x counts as weak, below 0.9x refutes it).",
  "check": {
    "source": "data/summary.json",
    "path": "terms.weekly",
    "label_field": "week",
    "stat": "mean_ratio_a_over_b",
    "unit": "x",
    "field": "weird_points",
    "per_label": "points per story",
    "group_a": {
      "label": "Weird words",
      "field": "weird_points",
      "per": "weird_stories",
      "indices": "all"
    },
    "group_b": {
      "label": "Everything else",
      "field": "weird_rest_points",
      "per": "weird_rest_stories",
      "indices": "all"
    }
  },
  "verdicts": [
    {
      "when": {
        "op": ">=",
        "value": 1.3
      },
      "verdict": "supported",
      "confidence": "strong"
    },
    {
      "when": {
        "op": ">=",
        "value": 1.1
      },
      "verdict": "supported",
      "confidence": "weak"
    },
    {
      "when": {
        "op": "<=",
        "value": 0.9
      },
      "verdict": "refuted",
      "confidence": "strong"
    },
    {
      "else": true,
      "verdict": "inconclusive",
      "confidence": "inconclusive"
    }
  ],
  "caveats": [
    "Word list was fixed in advance (scripts/terms.py) and is a rough stand-in for weird.",
    "Points are skewed: one hit story can move a week.",
    "Stories only, about 10 complete weeks."
  ]
}
