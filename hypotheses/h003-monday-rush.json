{
  "schema": 1,
  "id": "h003",
  "title": "Monday rush",
  "author": "agam",
  "hypothesis": "Everyone comes back to the keyboard on Monday: it is the busiest day of the week.",
  "expect": "If true, average items on Mondays should be at least 1.15x the average of the other six days (1.10x counts as weak).",
  "check": {
    "source": "data/summary.json",
    "path": "concentration.cyclic.weekday",
    "field": "posts",
    "normalize": "per_weekday_occurrence",
    "labels": [
      "Mon",
      "Tue",
      "Wed",
      "Thu",
      "Fri",
      "Sat",
      "Sun"
    ],
    "group_a": {
      "label": "Monday",
      "indices": [
        0
      ]
    },
    "group_b": {
      "label": "Other days",
      "indices": [
        1,
        2,
        3,
        4,
        5,
        6
      ]
    },
    "stat": "mean_ratio_a_over_b",
    "unit": "x"
  },
  "verdicts": [
    {
      "when": {
        "op": ">=",
        "value": 1.15
      },
      "verdict": "supported",
      "confidence": "strong"
    },
    {
      "when": {
        "op": ">=",
        "value": 1.1
      },
      "verdict": "supported",
      "confidence": "weak"
    },
    {
      "when": {
        "op": "<=",
        "value": 0.95
      },
      "verdict": "refuted",
      "confidence": "strong"
    },
    {
      "else": true,
      "verdict": "inconclusive",
      "confidence": "inconclusive"
    }
  ],
  "caveats": [
    "Weekdays are UTC.",
    "11-week window: about 11 Mondays, so one odd Monday matters.",
    "Comparing against the other six days includes the quiet weekend, which flatters Monday."
  ]
}
