{
  "schema": 1,
  "id": "h007",
  "title": "Saturday is for side projects",
  "author": "agam",
  "hypothesis": "Saturday is the day people ship and share personal projects: it is busier than Sunday.",
  "expect": "If true, average items on Saturdays should be at least 1.1x Sundays (below 0.9x refutes it).",
  "check": {
    "source": "data/summary.json",
    "path": "concentration.cyclic.weekday",
    "field": "posts",
    "normalize": "per_weekday_occurrence",
    "labels": [
      "Mon",
      "Tue",
      "Wed",
      "Thu",
      "Fri",
      "Sat",
      "Sun"
    ],
    "group_a": {
      "label": "Saturday",
      "indices": [
        5
      ]
    },
    "group_b": {
      "label": "Sunday",
      "indices": [
        6
      ]
    },
    "stat": "mean_ratio_a_over_b",
    "unit": "x"
  },
  "verdicts": [
    {
      "when": {
        "op": ">=",
        "value": 1.1
      },
      "verdict": "supported",
      "confidence": "strong"
    },
    {
      "when": {
        "op": "<=",
        "value": 0.9
      },
      "verdict": "refuted",
      "confidence": "strong"
    },
    {
      "else": true,
      "verdict": "inconclusive",
      "confidence": "inconclusive"
    }
  ],
  "caveats": [
    "Weekdays are UTC. Late Friday in the Americas lands on Saturday UTC.",
    "Counts all items, not only Show HN. A Show HN check would need a title-based summary.",
    "11-week window."
  ]
}
