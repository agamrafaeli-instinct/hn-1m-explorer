{
  "schema": 1,
  "id": "h311",
  "title": "Systems languages (Rust, Zig, C++) gain share",
  "author": "film-cards",
  "audience": "engineers",
  "hypothesis": "Rust, Zig and C++ together grow as a share of stories.",
  "expect": "If true, the share of stories mentioning Rust, Zig or C++ should be at least 1.3x higher in the latest 12 months than in all earlier stories since 2006 (pooled) (1.1x is weak, 0.9x or lower refutes it).",
  "check": {
    "source": "data/film_shares.json",
    "path": "monthly",
    "label_field": "month",
    "stat": "pooled_share_ratio",
    "unit": "x",
    "field": "syslang_s",
    "per_label": "Rust, Zig and C++ share of stories",
    "display_pct": true,
    "group_a": {
      "label": "Latest 12 months ({from} to {to})",
      "indices": {
        "last": 12
      },
      "field": "syslang_s",
      "per": "total"
    },
    "group_b": {
      "label": "All earlier stories ({from} to {to})",
      "indices": {
        "before_last": 12
      },
      "field": "syslang_s",
      "per": "total"
    }
  },
  "verdicts": [
    {
      "when": {
        "op": ">=",
        "value": 1.3
      },
      "verdict": "supported",
      "confidence": "strong"
    },
    {
      "when": {
        "op": ">=",
        "value": 1.1
      },
      "verdict": "supported",
      "confidence": "weak"
    },
    {
      "when": {
        "op": "<=",
        "value": 0.9
      },
      "verdict": "refuted",
      "confidence": "strong"
    },
    {
      "else": true,
      "verdict": "inconclusive",
      "confidence": "inconclusive"
    }
  ],
  "thresholds_note": "Exploratory. Thresholds copied from the card this one replaces."
}
