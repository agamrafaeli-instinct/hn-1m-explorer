{
  "schema": 1,
  "id": "h315",
  "title": "Go is gaining on Python",
  "author": "film-cards",
  "audience": "engineers",
  "hypothesis": "Go stories grow faster than Python stories.",
  "expect": "If true, the ratio of Go stories to Python stories should be at least 1.3x higher in the latest 12 months than in all earlier stories since 2006 (pooled) (1.1x is weak, 0.95x or lower refutes it).",
  "check": {
    "source": "data/film_shares.json",
    "path": "monthly",
    "label_field": "month",
    "stat": "pooled_share_ratio",
    "unit": "x",
    "field": "go_s",
    "per_label": "Go per Python story",
    "display_pct": false,
    "group_a": {
      "label": "Latest 12 months ({from} to {to})",
      "indices": {
        "last": 12
      },
      "field": "go_s",
      "per": "python_s"
    },
    "group_b": {
      "label": "All earlier stories ({from} to {to})",
      "indices": {
        "before_last": 12
      },
      "field": "go_s",
      "per": "python_s"
    }
  },
  "verdicts": [
    {
      "when": {
        "op": ">=",
        "value": 1.3
      },
      "verdict": "supported",
      "confidence": "strong"
    },
    {
      "when": {
        "op": ">=",
        "value": 1.1
      },
      "verdict": "supported",
      "confidence": "weak"
    },
    {
      "when": {
        "op": "<=",
        "value": 0.95
      },
      "verdict": "refuted",
      "confidence": "strong"
    },
    {
      "else": true,
      "verdict": "inconclusive",
      "confidence": "inconclusive"
    }
  ],
  "thresholds_note": "Exploratory. Thresholds copied from the card this one replaces."
}
