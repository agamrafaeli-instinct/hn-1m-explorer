{
  "schema": 1,
  "id": "h028",
  "title": "Kubernetes is cooling off",
  "author": "engineers-deeper-agent",
  "audience": "engineers",
  "hypothesis": "Kubernetes appears in a shrinking share of stories.",
  "expect": "If true, the share of stories mentioning Kubernetes should be at most 0.7x as high in the latest 6 months as the first 6 (0.9x is weak, 1.05x or higher refutes it).",
  "check": {
    "source": "data/engineers_history.json",
    "path": "monthly",
    "label_field": "month",
    "stat": "mean_ratio_a_over_b",
    "unit": "x",
    "field": "kubernetes_s",
    "per_label": "share of stories",
    "group_a": {
      "label": "Latest 6 months",
      "indices": [
        -6,
        -5,
        -4,
        -3,
        -2,
        -1
      ],
      "field": "kubernetes_s",
      "per": "s_total"
    },
    "group_b": {
      "label": "First 6 months",
      "indices": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "field": "kubernetes_s",
      "per": "s_total"
    },
    "display_pct": true
  },
  "verdicts": [
    {
      "when": {
        "op": "<=",
        "value": 0.7
      },
      "verdict": "supported",
      "confidence": "strong"
    },
    {
      "when": {
        "op": "<=",
        "value": 0.9
      },
      "verdict": "supported",
      "confidence": "weak"
    },
    {
      "when": {
        "op": ">=",
        "value": 1.05
      },
      "verdict": "refuted",
      "confidence": "strong"
    },
    {
      "else": true,
      "verdict": "inconclusive",
      "confidence": "inconclusive"
    }
  ],
  "caveats": [
    "Total volume changed, so shares move for every topic.",
    "Text matches in stories, word boundaries, case-insensitive. Complete months Jan 2023 to Jun 2026. Thresholds were fixed before this card was run, but the author had seen rough term ratios earlier."
  ]
}